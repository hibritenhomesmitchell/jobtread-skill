# JobTread Pave API configuration
# Copy this to .env and fill in your values, then `source .env` or use a
# tool like direnv before running the CLI.

# Your JobTread grant key (required).
# Generate one at: https://app.jobtread.com/grants
JT_GRANT_KEY=

# Override the Pave API endpoint (defaults to https://api.jobtread.com/pave)
# JT_PAVE_API_URL=https://api.jobtread.com/pave

# Override the signed-PDF base URL (defaults to https://api.jobtread.com/t/)
# JT_PDF_BASE_URL=https://api.jobtread.com/t/
